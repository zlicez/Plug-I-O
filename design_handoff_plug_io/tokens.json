{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Plug-I/O design tokens. W3C Design Tokens Community Group format. Mirrors design_canvas/src/tokens.css.",
  "color": {
    "bg":          { "$type": "color", "$value": "#0F0F10" },
    "bg-2":        { "$type": "color", "$value": "#131416" },
    "surface":     { "$type": "color", "$value": "#161719" },
    "surface-2":   { "$type": "color", "$value": "#1D1F23" },
    "control":     { "$type": "color", "$value": "#26292E" },
    "control-hover":{"$type": "color", "$value": "#2D3137" },
    "line":        { "$type": "color", "$value": "#2A2E34" },
    "line-2":      { "$type": "color", "$value": "#34383F" },
    "line-strong": { "$type": "color", "$value": "#4C525D" },
    "copy":        { "$type": "color", "$value": "#F0F1F2" },
    "copy-2":      { "$type": "color", "$value": "#C8CCD2" },
    "muted":       { "$type": "color", "$value": "#9DA4AF" },
    "muted-2":     { "$type": "color", "$value": "#6B7280" },
    "dim":         { "$type": "color", "$value": "#4B5159" },

    "accent":      { "$type": "color", "$value": "#C8FF00" },
    "accent-2":    { "$type": "color", "$value": "#B6E800" },
    "accent-soft": { "$type": "color", "$value": "rgba(200, 255, 0, 0.14)" },
    "accent-ring": { "$type": "color", "$value": "rgba(200, 255, 0, 0.30)" },
    "accent-text": { "$type": "color", "$value": "#0F0F10" },

    "positive":      { "$type": "color", "$value": "#4ADE80" },
    "positive-soft": { "$type": "color", "$value": "rgba(74, 222, 128, 0.14)" },
    "warning":       { "$type": "color", "$value": "#F2A93B" },
    "warning-soft":  { "$type": "color", "$value": "rgba(242, 169, 59, 0.14)" },
    "danger":        { "$type": "color", "$value": "#E05454" },
    "danger-soft":   { "$type": "color", "$value": "rgba(224, 84, 84, 0.14)" },
    "info":          { "$type": "color", "$value": "#4093D6" },
    "info-soft":     { "$type": "color", "$value": "rgba(64, 147, 214, 0.14)" }
  },
  "protocol": {
    "$description": "11 protocols. Each carries a color AND a dash pattern for colorblind safety.",
    "analog":      { "color": { "$type": "color", "$value": "#E0A458" }, "dash": { "$type": "string", "$value": "solid"  }, "short": { "$type": "string", "$value": "ANA" } },
    "aes":         { "color": { "$type": "color", "$value": "#6EE7FF" }, "dash": { "$type": "string", "$value": "dashed" }, "short": { "$type": "string", "$value": "AES" } },
    "spdif":       { "color": { "$type": "color", "$value": "#F2A93B" }, "dash": { "$type": "string", "$value": "dotted" }, "short": { "$type": "string", "$value": "SPD" } },
    "adat":        { "color": { "$type": "color", "$value": "#B58CFF" }, "dash": { "$type": "string", "$value": "dashed" }, "short": { "$type": "string", "$value": "ADT" } },
    "dante":       { "color": { "$type": "color", "$value": "#6366F1" }, "dash": { "$type": "string", "$value": "solid"  }, "short": { "$type": "string", "$value": "DNT" } },
    "madi":        { "color": { "$type": "color", "$value": "#FF7AB6" }, "dash": { "$type": "string", "$value": "dashed" }, "short": { "$type": "string", "$value": "MAD" } },
    "midi":        { "color": { "$type": "color", "$value": "#4ADE80" }, "dash": { "$type": "string", "$value": "dotted" }, "short": { "$type": "string", "$value": "MID" } },
    "wclock":      { "color": { "$type": "color", "$value": "#9DA4AF" }, "dash": { "$type": "string", "$value": "solid"  }, "short": { "$type": "string", "$value": "WCK" } },
    "usb":         { "color": { "$type": "color", "$value": "#6EE7FF" }, "dash": { "$type": "string", "$value": "dashed" }, "short": { "$type": "string", "$value": "USB" } },
    "thunderbolt": { "color": { "$type": "color", "$value": "#B58CFF" }, "dash": { "$type": "string", "$value": "solid"  }, "short": { "$type": "string", "$value": "TB"  } },
    "power":       { "color": { "$type": "color", "$value": "#E05454" }, "dash": { "$type": "string", "$value": "solid"  }, "short": { "$type": "string", "$value": "PWR" } },
    "bluetooth":   { "color": { "$type": "color", "$value": "#4093D6" }, "dash": { "$type": "string", "$value": "solid"  }, "short": { "$type": "string", "$value": "BT"  } }
  },
  "radius": {
    "1":    { "$type": "dimension", "$value": "3px"   },
    "2":    { "$type": "dimension", "$value": "6px"   },
    "3":    { "$type": "dimension", "$value": "8px"   },
    "4":    { "$type": "dimension", "$value": "10px"  },
    "5":    { "$type": "dimension", "$value": "14px"  },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "spacing": {
    "1":  { "$type": "dimension", "$value": "4px"  },
    "2":  { "$type": "dimension", "$value": "8px"  },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "fontFamily": {
    "sans": { "$type": "fontFamily", "$value": ["DM Sans", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "JetBrains Mono", "Menlo", "Consolas", "monospace"] }
  },
  "fontSize": {
    "10": { "$type": "dimension", "$value": "10px" },
    "11": { "$type": "dimension", "$value": "11px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "13": { "$type": "dimension", "$value": "13px" },
    "14": { "$type": "dimension", "$value": "14px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "20": { "$type": "dimension", "$value": "20px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" },
    "40": { "$type": "dimension", "$value": "40px" },
    "56": { "$type": "dimension", "$value": "56px" }
  },
  "duration": {
    "instant": { "$type": "duration", "$value": "80ms"  },
    "fast":    { "$type": "duration", "$value": "160ms" },
    "base":    { "$type": "duration", "$value": "240ms" },
    "slow":    { "$type": "duration", "$value": "400ms" },
    "deep":    { "$type": "duration", "$value": "600ms" }
  },
  "easing": {
    "standard":    { "$type": "cubicBezier", "$value": [0.2, 0,   0,   1] },
    "emphasized":  { "$type": "cubicBezier", "$value": [0.3, 0,   0,   1] },
    "decelerated": { "$type": "cubicBezier", "$value": [0.05, 0.7, 0.1, 1] },
    "accelerated": { "$type": "cubicBezier", "$value": [0.3, 0,   0.8, 0.15] }
  },
  "elevation": {
    "1": { "$type": "shadow", "$value": "inset 0 1px 0 0 rgba(255,255,255,0.04), 0 1px 0 0 rgba(0,0,0,0.4)" },
    "2": { "$type": "shadow", "$value": "inset 0 1px 0 0 rgba(255,255,255,0.06), 0 4px 16px -4px rgba(0,0,0,0.6)" },
    "3": { "$type": "shadow", "$value": "inset 0 1px 0 0 rgba(255,255,255,0.08), 0 12px 40px -8px rgba(0,0,0,0.7)" },
    "focus-ring": { "$type": "shadow", "$value": "0 0 0 2px var(--bg), 0 0 0 4px var(--accent)" }
  },
  "rack": {
    "$description": "Rack-specific layout constants",
    "u-height":  { "$type": "dimension", "$value": "38px" },
    "inner-width": { "$type": "dimension", "$value": "460px" },
    "ear-width": { "$type": "dimension", "$value": "32px" }
  }
}
